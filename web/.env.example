# Keep this empty locally and on Vercel. The browser uses same-origin /api;
# Vite proxies it to port 4000 during local development.
VITE_API_BASE_URL=

# Public browser credentials from Supabase Dashboard -> Project Settings -> API.
# These are safe to expose in the Vite bundle; never put the service-role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
