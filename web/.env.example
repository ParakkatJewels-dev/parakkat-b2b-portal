# Public browser credentials from Supabase Dashboard -> Project Settings -> API, used for the
# live-update channels (Supabase Realtime). Safe to ship to browsers; never put the service-role
# key here. The API is part of this same Next.js app, so there is no API URL to configure.
# (The old VITE_SUPABASE_* names are still read.)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
