{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "installCommand": "cd .. && npm ci",
  "buildCommand": "cd .. && npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/dunning",
      "schedule": "0 3 * * *"
    }
  ]
}
